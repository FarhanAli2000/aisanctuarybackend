# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Get this from MongoDB Atlas -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai-sanctuary?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# n8n webhook base URL (self-hosted n8n server)
# Backend calls n8n webhooks to trigger automation (emails, reminders, etc.)
N8N_WEBHOOK_BASE_URL=https://your-n8n-server.example.com/webhook
N8N_API_KEY=replace_with_shared_secret_between_backend_and_n8n

# File storage (documents/CNIC images)
# Phase 1 stores locally; swap to S3/Cloudinary in production
# Attendance alert threshold (percent). Below this, n8n WF-03 emails student + admin.
ATTENDANCE_ALERT_THRESHOLD=75
